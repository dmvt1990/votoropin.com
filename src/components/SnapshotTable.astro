---
// src/components/SnapshotTable.astro
// One reporting period across every constituent of an index.
//
// The per-constituent FundamentalsTable is this table's transpose: one company
// down five years. This one is one period across ten companies, which is the
// comparison an index needs and which no single issuer page can give.
//
// Generated by `ritix-fa snapshot` into src/data/ritix-snapshot.json — see
// scripts/refresh-snapshot.sh. Rows carry stable keys and no display label, so
// both language builds render from the one file, and the labels are the same
// ones the constituent pages use (t.fundamentals.rows).

import { t } from "../i18n";

export interface SnapRow {
  key: string;
  section: string | null;
  kind: "money" | "ratio" | "pct";
  basis: "period" | "trailing";
  values: Record<string, number | null>;
}

export interface Snapshot {
  index: string;
  name: string;
  period: string;
  price_month: string;
  generated: string;
  unit: string;
  tickers: string[];
  names: Record<string, { ru: string; en: string | null }>;
  covered: Record<string, boolean>;
  prices: Record<string, { date: string; close: number } | null>;
  rows: SnapRow[];
}

export interface Props {
  data: Snapshot;
  indexSlug: string;
}

const { data, indexSlug } = Astro.props;
const ru = import.meta.env.PUBLIC_LANG === "ru";
const S = t.snapshot;
const F = t.fundamentals;

// Russian statements group thousands with a space; English with a comma.
const group = (s: string) => (ru ? s.replace(/,/g, " ") : s);
function money(v: number | null): string {
  if (v === null) return "—";
  return group(Math.round(v).toLocaleString("en-US"));
}
function dec(v: number | null, d = 1): string {
  if (v === null) return "—";
  const s = v.toLocaleString("en-US", { minimumFractionDigits: d, maximumFractionDigits: d });
  return ru ? group(s).replace(".", ",") : s;
}
const cell = (v: number | null, kind: string) => (kind === "money" ? money(v) : dec(v));
const rowLabel = (key: string) => (F.rows as Record<string, string>)[key] ?? key;
const rowNote = (key: string) => (F.notes as Record<string, string>)[key] ?? "";

// Constituents in the order the snapshot lists them, largest first — the same
// order the index roster carries.
const cols = data.tickers;

// Group rows under their section, preserving generator order.
const sections: { key: string; rows: SnapRow[] }[] = [];
for (const r of data.rows) {
  const key = r.section ?? "";
  const last = sections[sections.length - 1];
  if (last && last.key === key) last.rows.push(r);
  else sections.push({ key, rows: [r] });
}

const missing = cols.filter((tk) => !data.covered[tk]);
const missingText = S.missing as Record<string, string>;
const sourceNote = S.sourceNote.replace("{generated}", data.generated);
---

<section class="border-t border-rule">
  <div class="container-wide py-20">
    <div class="section-label">{S.label}</div>
    <h2 class="display font-normal text-[28px] tracking-tight m-0 mb-4">{S.heading}</h2>
    <p class="text-[16px] leading-relaxed text-ink-soft max-w-[62ch] m-0 mb-8">{S.intro}</p>

    <div class="overflow-x-auto bg-bg border border-rule">
      <table class="w-full border-collapse min-w-[1000px]">
        <thead>
          <tr class="bg-bg-sunken">
            <th
              class="text-left px-5 py-4 text-[11px] uppercase tracking-wider2 text-ink-mute font-medium border-b border-rule sticky left-0 bg-bg-sunken z-10"
            >
              {S.unitHeader}
            </th>
            {
              cols.map((tk) => (
                <th class="text-right px-4 py-4 text-[11px] uppercase tracking-wider2 font-medium border-b border-rule whitespace-nowrap">
                  <a
                    href={`/indices/${indexSlug}/${tk.toLowerCase()}`}
                    class="text-accent no-underline hover:underline"
                  >
                    {tk}
                  </a>
                </th>
              ))
            }
          </tr>
        </thead>
        <tbody>
          {
            sections.map((s) => (
              <>
                {s.key && (
                  <tr>
                    <th
                      colspan={cols.length + 1}
                      scope="rowgroup"
                      class="text-left px-5 pt-6 pb-2 text-[11px] uppercase tracking-[0.18em] text-accent font-medium border-b border-rule"
                    >
                      {rowLabel(s.key)}
                    </th>
                  </tr>
                )}
                {s.rows.map((r) => (
                  <tr class="border-b border-rule">
                    <th
                      scope="row"
                      class="text-left px-5 py-3 font-display text-[15px] font-normal sticky left-0 bg-bg z-10 whitespace-nowrap"
                    >
                      {rowLabel(r.key)}
                      {r.basis === "trailing" && (
                        <span class="ml-2 font-mono text-[10px] uppercase tracking-wider2 text-accent align-middle">
                          {S.trailingTag}
                        </span>
                      )}
                      {rowNote(r.key) && (
                        <span class="ml-2 font-sans text-[11px] text-ink-mute">{rowNote(r.key)}</span>
                      )}
                    </th>
                    {cols.map((tk) => (
                      <td class="px-4 py-3 font-mono text-[14px] text-right numeric whitespace-nowrap">
                        {cell(r.values[tk] ?? null, r.kind)}
                      </td>
                    ))}
                  </tr>
                ))}
              </>
            ))
          }
        </tbody>
      </table>
    </div>

    <div class="grid gap-8 md:grid-cols-2 mt-10">
      <div>
        <div class="font-sans text-[11px] uppercase tracking-[0.18em] text-accent font-medium mb-3">
          {S.basisHeading}
        </div>
        <p class="text-[14px] leading-relaxed text-ink-soft m-0 mb-3">{S.basisFlow}</p>
        <p class="text-[14px] leading-relaxed text-ink-soft m-0 mb-3">{S.basisTrailing}</p>
        <p class="text-[14px] leading-relaxed text-ink-soft m-0">{S.basisPrice}</p>
      </div>

      <div>
        <div class="font-sans text-[11px] uppercase tracking-[0.18em] text-accent font-medium mb-3">
          {S.readLabel}
        </div>
        <ul class="list-none p-0 m-0 border-t border-rule">
          {
            Object.values(S.read).map((line) => (
              <li class="py-3 border-b border-rule text-[14px] leading-relaxed text-ink-soft">
                {line}
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    {
      missing.length > 0 && (
        <div class="mt-8 bg-bg-sunken border-l-2 border-accent p-6">
          <div class="font-sans text-[11px] uppercase tracking-[0.18em] text-accent font-medium mb-3">
            {S.missingLabel}
          </div>
          <ul class="list-none p-0 m-0">
            {missing.map((tk) => (
              <li class="text-[14px] leading-relaxed text-ink-soft mb-2">
                <span class="font-mono text-[12px] text-ink mr-2">{tk}</span>
                {missingText[tk] ?? ""}
              </li>
            ))}
          </ul>
          <p class="text-[13px] leading-relaxed text-ink-mute m-0 mt-3">{S.missingNote}</p>
        </div>
      )
    }

    <p class="mt-6 text-[13px] text-ink-mute italic m-0">{sourceNote}</p>

    <div class="mt-8 bg-bg-sunken border-l-2 border-accent p-6">
      <div class="font-sans text-[11px] uppercase tracking-[0.18em] text-accent font-medium mb-3">
        {F.page.disclaimerLabel}
      </div>
      <p class="text-[14px] leading-relaxed text-ink-soft m-0">{F.page.disclaimer}</p>
    </div>
  </div>
</section>
