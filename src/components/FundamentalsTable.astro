---
// src/components/FundamentalsTable.astro
// Financial-analysis grid for a single index constituent.
//
// The data is generated by the ritix-fa pipeline (`ritix-fa fa <TICKER> --json`)
// from the issuer's own filings and dropped into src/data/fundamentals/. Rows
// carry a stable `key`, never a display label, so both language builds render
// from one file — see t.fundamentals.rows.

import { t } from "../i18n";

export interface FundRow {
  key: string;
  label: string;
  kind: "money" | "ratio" | "pct";
  note?: string;
  values: (number | null)[];
  sub?: "growth" | "pp";
  subValues?: (number | null)[];
}

export interface FundSection {
  key: string;
  label: string;
  rows: FundRow[];
}

export interface Fundamentals {
  ticker: string;
  name: string;
  name_en: string | null;
  unit: string;
  generated: string;
  columns: string[];
  spot: { date: string; price: number; shares: number };
  closes: Record<string, { secid: string; date: string; close: number }>;
  sources: { document: string; values: number }[];
  facts: number;
  sections: FundSection[];
}

export interface Props {
  data: Fundamentals;
}

const { data } = Astro.props;
const ru = import.meta.env.PUBLIC_LANG === "ru";
const T = t.fundamentals;

// Russian statements group thousands with a space; English with a comma.
const group = (s: string) => (ru ? s.replace(/,/g, " ") : s);

function money(v: number | null): string {
  if (v === null) return "—";
  return group(Math.round(v).toLocaleString("en-US"));
}
function dec(v: number | null, d = 1): string {
  if (v === null) return "—";
  const s = v.toLocaleString("en-US", { minimumFractionDigits: d, maximumFractionDigits: d });
  return ru ? group(s).replace(".", ",") : s;
}
const cell = (v: number | null, kind: string) => (kind === "money" ? money(v) : dec(v));
const label = (key: string, fallback: string) =>
  (T.rows as Record<string, string>)[key] ?? fallback;
const note = (key: string) => (T.notes as Record<string, string>)[key] ?? "";
---

<div>
  <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2 mb-6">
    <h2 class="font-display text-[28px] font-normal m-0">{T.heading}</h2>
    <span class="font-mono text-[12px] text-ink-mute">{T.unitNote}</span>
  </div>

  <div class="overflow-x-auto bg-bg border border-rule">
    <table class="w-full border-collapse min-w-[700px]">
      <thead>
        <tr class="bg-bg-sunken">
          <th
            class="text-left px-5 py-4 text-[11px] uppercase tracking-wider2 text-ink-mute font-medium border-b border-rule sticky left-0 bg-bg-sunken z-10"
          >
            {T.unitHeader}
          </th>
          {
            data.columns.map((c) => (
              <th class="text-right px-5 py-4 text-[11px] uppercase tracking-wider2 text-ink-mute font-medium border-b border-rule whitespace-nowrap">
                {c === "LTM" ? T.ltm : c}
              </th>
            ))
          }
        </tr>
      </thead>
      <tbody>
        {
          data.sections.map((section) => (
            <>
              <tr>
                <th
                  colspan={data.columns.length + 1}
                  scope="rowgroup"
                  class="text-left px-5 pt-6 pb-2 text-[11px] uppercase tracking-[0.18em] text-accent font-medium border-b border-rule"
                >
                  {label(section.key, section.label)}
                </th>
              </tr>
              {section.rows.map((r) => (
                <>
                  <tr class={r.sub ? "" : "border-b border-rule"}>
                    <th
                      scope="row"
                      class="text-left px-5 pt-3.5 pb-1 font-display text-[15px] font-normal sticky left-0 bg-bg z-10 whitespace-nowrap"
                    >
                      {label(r.key, r.label)}
                      {note(r.key) && (
                        <span class="ml-2 font-sans text-[11px] text-ink-mute">{note(r.key)}</span>
                      )}
                    </th>
                    {r.values.map((v) => (
                      <td class="px-5 pt-3.5 pb-1 font-mono text-[14px] text-right numeric whitespace-nowrap">
                        {cell(v, r.kind)}
                      </td>
                    ))}
                  </tr>
                  {r.sub && (
                    <tr class="border-b border-rule">
                      <th
                        scope="row"
                        class="text-left pl-9 pr-5 pt-0 pb-3.5 text-[11px] font-normal text-ink-mute sticky left-0 bg-bg z-10 whitespace-nowrap"
                      >
                        {r.sub === "growth" ? T.growth : T.changePp}
                      </th>
                      {(r.subValues ?? []).map((v) => (
                        <td
                          class:list={[
                            "px-5 pt-0 pb-3.5 font-mono text-[12px] text-right numeric whitespace-nowrap",
                            v === null ? "text-ink-mute" : v > 0 ? "text-positive" : v < 0 ? "text-negative" : "text-ink-mute",
                          ]}
                        >
                          {v === null ? "—" : `${v > 0 ? "+" : ""}${dec(v)}`}
                        </td>
                      ))}
                    </tr>
                  )}
                </>
              ))}
            </>
          ))
        }
      </tbody>
    </table>
  </div>
</div>
